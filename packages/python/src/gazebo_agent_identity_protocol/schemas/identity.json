{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.gazebohq.com/v0.1/identity.json",
  "title": "AIP v0.1 Agent Identity Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "aip", "id", "name", "description", "author", "version", "scope"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "Use the canonical AIP URL, or an explicitly verified equivalent mirror."
    },
    "aip": {"const": "0.1"},
    "id": {"$ref": "#/$defs/identifier"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "version": {"$ref": "#/$defs/semver"},
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scopeItem"}
    },
    "install_url": {"type": "string", "format": "uri"},
    "verify_url": {"type": "string", "format": "uri"},
    "published_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:(?:[a-z][a-z0-9-]*|\\*)$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "scopeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "actions"],
      "properties": {
        "service": {"$ref": "#/$defs/identifier"},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/action"}
        }
      }
    }
  }
}