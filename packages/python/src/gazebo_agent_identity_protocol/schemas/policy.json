{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.gazebohq.com/v0.1/policy.json",
  "title": "AIP v0.1 Access Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "aip", "agent_id", "install_id", "version", "policy"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "Use the canonical AIP URL, or an explicitly verified equivalent mirror."
    },
    "aip": {"const": "0.1"},
    "agent_id": {"$ref": "#/$defs/identifier"},
    "install_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "version": {"$ref": "#/$defs/semver"},
    "policy": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scopeItem"}
    },
    "approval_rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/approvalRule"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:(?:[a-z][a-z0-9-]*|\\*)$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "scopeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "actions"],
      "properties": {
        "service": {"$ref": "#/$defs/identifier"},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/action"}
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "amount_usd": {"type": "number", "minimum": 0},
        "record_count": {"type": "integer", "minimum": 0}
      }
    },
    "approvalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "actions", "requires_approval"],
      "properties": {
        "service": {"$ref": "#/$defs/identifier"},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/action"}
        },
        "threshold": {"$ref": "#/$defs/threshold"},
        "requires_approval": {"const": true}
      }
    }
  }
}